# Copy to .env and fill in. Never commit .env.
# Database (mysql2 pool, src/db/pool.js)
DBHOST=localhost
DBUSER=
DBPASS=
DBNAME=proyecto_dual
# Use a MySQL account with only the privileges the app needs, not root.
# TLS to MySQL (required when the database is on another host): DBSSL=true,
# and DBSSL_CA=/path/to/ca.pem if the server certificate is not publicly trusted.
DBSSL=false
DBSSL_CA=

# HTTP port (default 3001; the frontend dev proxy expects 3001)
PORT=3001
# Number of reverse proxies in front of the API (e.g. 1 behind nginx). Leave
# empty when the API is reached directly. Rate limits use the client IP from it.
TRUST_PROXY=
# Public sign-up limits (student and company forms).
SIGNUP_MAX_PER_IP_HOUR=10
SIGNUP_MAX_PER_DAY=300
# Most places a company can offer per ciclo.
MAX_PLAZAS_POR_CICLO=20

# REQUIRED. At least 32 random characters. The server refuses to start without it.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Changing it logs every user out.
JWT_SECRET=

# Gmail account used by Nodemailer (src/mail/config.js)
EMAIL_USER=
EMAIL_PASS=

# Email delivery (src/mail/config.js). smtp = send through Gmail; log = send
# nothing and write a masked line to the server log. Default: smtp only when
# NODE_ENV=production, log otherwise. PRODUCTION MUST SEND: set MAIL_MODE=smtp
# (or NODE_ENV=production) there, or no email at all leaves the server.
MAIL_MODE=log
# Optional, smtp only: deliver every email to this one address (template checks).
MAIL_REDIRECT_TO=
# Public address of the portal (e.g. https://dual.example.org), used for the links in
# notifications and in the password reset email. REQUIRED in production: without it no
# reset link is sent. In development it defaults to http://localhost:3000.
APP_URL=

# Optional, scripts/seedDemo.js only: staff logins of the demo data.
DEMO_ADMIN_EMAIL=
DEMO_COORD_EMAIL=
