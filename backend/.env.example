# Copy to .env and fill in. Never commit .env.
# Database (mysql2 pool, src/db/pool.js)
DBHOST=localhost
DBUSER=
DBPASS=
DBNAME=proyecto_dual

# HTTP port (default 3001; the frontend dev proxy expects 3001)
PORT=3001

# REQUIRED. At least 32 random characters. The server refuses to start without it.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Changing it logs every user out.
JWT_SECRET=

# Gmail account used by Nodemailer (src/mail/config.js)
EMAIL_USER=
EMAIL_PASS=
