# Copy to .env and fill in. Never commit .env.
# Database (mysql2 pool, src/db/pool.js)
DBHOST=localhost
DBNAME=proyecto_dual
# The account the API runs with: only what it uses (read, insert, update,
# run procedures, delete in three tables), never root. Create or update it with
#   DBADMIN_USER=root DBADMIN_PASS=... node scripts/cuentaApp.js --yes --pruebas
DBUSER=fpdual_app
DBPASS=
# The schema owner, for scripts only (migrations, backups, demo data, the DB
# tests): root or an account with all rights on DBNAME. Empty = the scripts use
# DBUSER, which then needs those rights.
DBADMIN_USER=
DBADMIN_PASS=
# TLS to MySQL (required when the database is on another host): DBSSL=true,
# and DBSSL_CA=/path/to/ca.pem if the server certificate is not publicly trusted.
DBSSL=false
DBSSL_CA=

# HTTP port (default 3001; the frontend dev proxy expects 3001)
PORT=3001
# Number of reverse proxies in front of the API (e.g. 1 behind nginx). Leave
# empty when the API is reached directly. Rate limits use the client IP from it.
TRUST_PROXY=
# Public sign-up limits (student and company forms).
SIGNUP_MAX_PER_IP_HOUR=10
SIGNUP_MAX_PER_DAY=300
# Most places a company can offer per ciclo.
MAX_PLAZAS_POR_CICLO=20

# REQUIRED. At least 32 random characters. The server refuses to start without it.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Changing it logs every user out.
JWT_SECRET=

# Email delivery (src/mail/config.js). Default: smtp when NODE_ENV=production,
# log otherwise.
#   log      send nothing; write a masked line to the server log.
#   mailpit  send every email to Mailpit, a local inbox at http://localhost:8025.
#            Start it with: docker compose -f docker-compose.dev.yml up -d
#   smtp     real delivery: Gmail (EMAIL_USER / EMAIL_PASS, an app password),
#            or another server with SMTP_HOST.
MAIL_MODE=log
# mailpit only (defaults shown):
#MAILPIT_HOST=localhost
#MAILPIT_PORT=1025
# smtp only:
EMAIL_USER=
EMAIL_PASS=
# Another SMTP server instead of Gmail (empty = Gmail). SMTP_SECURE=true for port 465.
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
# Optional, smtp only: deliver every email to this one address (template checks).
MAIL_REDIRECT_TO=
# Sender shown in every email (default: EMAIL_USER, or fpdual@localhost).
MAIL_FROM=
# Public address of the portal (e.g. https://dual.example.org), used for the links in
# notifications and in the password reset email. REQUIRED in production: without it no
# reset link is sent. In development it defaults to http://localhost:3000.
APP_URL=

# Optional, scripts/seedDemo.js only: staff logins of the demo data.
DEMO_ADMIN_EMAIL=
DEMO_COORD_EMAIL=

# Docker only (docker-compose.yml sets it): run Chromium for PDF generation
# without its sandbox, which a container cannot provide.
PUPPETEER_NO_SANDBOX=
