# Copy to .env and fill in. Never commit .env.
# Database (mysql2 pool, src/db/pool.js)
DBHOST=localhost
DBUSER=
DBPASS=
DBNAME=proyecto_dual

# HTTP port (default 3001; the frontend dev proxy expects 3001)
PORT=3001

# REQUIRED. At least 32 random characters. The server refuses to start without it.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Changing it logs every user out.
JWT_SECRET=

# Gmail account used by Nodemailer (src/mail/config.js)
EMAIL_USER=
EMAIL_PASS=

# Email delivery (src/mail/config.js). smtp = send through Gmail; log = send
# nothing and write a masked line to the server log. Default: smtp only when
# NODE_ENV=production, log otherwise. PRODUCTION MUST SEND: set MAIL_MODE=smtp
# (or NODE_ENV=production) there, or no email at all leaves the server.
MAIL_MODE=log
# Optional, smtp only: deliver every email to this one address (template checks).
MAIL_REDIRECT_TO=
# Public address of the portal (e.g. https://dual.example.org), used for the links in
# notifications and in the password reset email. REQUIRED in production: without it no
# reset link is sent. In development it defaults to http://localhost:3000.
APP_URL=
