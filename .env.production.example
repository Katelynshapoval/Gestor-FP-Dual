# Copy to .env next to docker-compose.yml and fill in. Never commit .env.

# Public domain. Caddy requests the HTTPS certificate for it.
SITE_ADDRESS=dual.example.org
# Same address with https://, used in the links inside emails. REQUIRED.
APP_URL=https://dual.example.org

# Database (the MySQL container creates this database and user on first start).
DBNAME=proyecto_dual
DBUSER=fpdual
# Long random values. Generate each with:
#   openssl rand -base64 33
DBPASS=
DB_ROOT_PASSWORD=

# REQUIRED. At least 32 random characters; changing it logs everyone out.
#   openssl rand -base64 48
JWT_SECRET=

# Gmail account used to send email (use an app password).
EMAIL_USER=
EMAIL_PASS=
# smtp = send for real (default here); log = send nothing, write a masked log line.
MAIL_MODE=smtp
# Optional: deliver every email to this one address (for a trial run).
MAIL_REDIRECT_TO=

# Optional limits (defaults shown).
#SIGNUP_MAX_PER_IP_HOUR=10
#SIGNUP_MAX_PER_DAY=300
#MAX_PLAZAS_POR_CICLO=20

# Optional: host ports if 80/443 are taken.
#HTTP_PORT=80
#HTTPS_PORT=443
