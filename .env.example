# Server settings for docker-compose.yml. Copy to .env next to it, fill it in
# and protect it:   cp .env.example .env && chmod 600 .env
# Never commit .env. docs/DESPLIEGUE.md explains each step.

# ── Address ──────────────────────────────────────────────────────────────────
# Name the users type in the browser. Intranet example: fpdual.centro.local
# (with no internal DNS, each computer adds "<server IP>  fpdual.centro.local"
# to its hosts file). Public example: dual.example.org.
SITE_ADDRESS=fpdual.centro.local
# The same address with https://, used in the links inside emails. REQUIRED.
APP_URL=https://fpdual.centro.local
# HTTPS certificate:
#   internal      Caddy's own certificate (intranet; browsers show a warning
#                 until they trust it: ./deploy/fpdual.sh certificado)
#   <an email>    Let's Encrypt, only for a public domain whose DNS points here
CADDY_TLS=internal
# Host ports, if 80/443 are taken.
#HTTP_PORT=80
#HTTPS_PORT=443

# ── Database ─────────────────────────────────────────────────────────────────
# Three accounts, each with its own long random password
# (generate each with:  openssl rand -base64 33):
#   DBADMIN_USER  owns the schema: the MySQL container creates it on its first
#                 start; migrations, backups and demo data run with it.
#   DBUSER        what the API runs with: read, insert, update, run procedures
#                 and delete in three tables. ./deploy/fpdual.sh creates it.
#   root          only to create DBUSER and for copia / restaurar.
DBNAME=proyecto_dual
DBADMIN_USER=fpdual_admin
DBADMIN_PASS=
DBUSER=fpdual_app
DBPASS=
DB_ROOT_PASSWORD=

# ── Backups ──────────────────────────────────────────────────────────────────
# ./deploy/fpdual.sh copia encrypts every backup with this key (AES-256).
# 32 characters or more:  openssl rand -base64 33
# Keep a copy somewhere other than this server: without it, no backup can be read.
BACKUP_KEY=
# How many backups ./deploy/fpdual.sh podar keeps (the newest ones). Default 30.
# BACKUP_KEEP=30

# ── Sessions ─────────────────────────────────────────────────────────────────
# REQUIRED. At least 32 random characters; changing it logs everyone out.
#   openssl rand -base64 48
JWT_SECRET=

# ── Email ────────────────────────────────────────────────────────────────────
# MAIL_MODE:
#   mailpit  every email goes to Mailpit, a web inbox at http://<server>:8025.
#            Nothing reaches real inboxes and no credentials are needed: use it
#            for a demo. Needs COMPOSE_PROFILES=mailpit (below).
#   smtp     real delivery: Gmail with EMAIL_USER / EMAIL_PASS (an app
#            password), or another server with SMTP_HOST.
#   log      nothing is sent; one masked line per email in the backend log.
MAIL_MODE=mailpit
# Starts the mailpit container. Leave empty when MAIL_MODE is not mailpit.
COMPOSE_PROFILES=mailpit
# Optional: user:password for the Mailpit inbox (without it, anyone on the
# network who opens port 8025 can read the emails).
MAILPIT_UI_AUTH=
#MAILPIT_UI_PORT=8025

# smtp only:
EMAIL_USER=
EMAIL_PASS=
# Another server instead of Gmail (empty = Gmail). SMTP_SECURE=true for port 465.
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
# Optional: deliver every email to this one address (a trial with real mail).
MAIL_REDIRECT_TO=

# Sender shown in every email (default: EMAIL_USER, or fpdual@localhost).
MAIL_FROM=

# ── Demo data (./deploy/fpdual.sh demo) ──────────────────────────────────────
# Staff logins it creates (any address works with Mailpit).
DEMO_ADMIN_EMAIL=admin.demo@fpdual.test
DEMO_COORD_EMAIL=coord.demo@fpdual.test

# ── Optional limits (defaults shown) ─────────────────────────────────────────
#SIGNUP_MAX_PER_IP_HOUR=10
#SIGNUP_MAX_PER_DAY=300
#MAX_PLAZAS_POR_CICLO=20
