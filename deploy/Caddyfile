# Public entry point.
#   CADDY_TLS=internal  certificate from Caddy's own authority, for an intranet
#                       name (fpdual.centro.local) with no public DNS. Browsers
#                       warn until they trust that authority's root
#                       (./deploy/fpdual.sh certificado exports it).
#   CADDY_TLS=<email>   Let's Encrypt for a real domain: ports 80 and 443
#                       reachable from the internet and the DNS record pointing
#                       here. The email receives expiry warnings.
{$SITE_ADDRESS} {
	tls {$CADDY_TLS:internal}
	encode gzip
	header Strict-Transport-Security "max-age=31536000; includeSubDomains"
	header -Server
	reverse_proxy web:80
}
